# Plantilla de variables de entorno para desarrollo local (FT00003).
#
# Copia este fichero a `.env` (ignorado por git) y ajústalo si lo necesitas.
# Los valores de aquí son **placeholders de desarrollo**, NO secretos reales ni
# credenciales válidas de nada: cámbialos en tu `.env` local. Los secretos de
# producción se inyectan por entorno en el servidor (FT00041) y **nunca** se
# versionan (ni los de desarrollo).

# Base de datos local levantada por docker-compose.
POSTGRES_DB=datopublico
POSTGRES_USER=datopublico
# Obligatorio: no hay default en docker-compose (`:?`). Placeholder de dev.
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_PORT=5432

# Conexión de Flyway para `./gradlew :backend:flywayMigrate`.
# `FLYWAY_URL`/`FLYWAY_USER` tienen default no sensible en el build, pero
# `FLYWAY_PASSWORD` NO: si falta (ni en `.env` ni exportado), la tarea falla con
# un mensaje claro. Debe coincidir con `POSTGRES_PASSWORD` en local.
FLYWAY_URL=jdbc:postgresql://localhost:5432/datopublico
FLYWAY_USER=datopublico
FLYWAY_PASSWORD=cambia_esta_clave_local
