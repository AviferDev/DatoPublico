# Copia este fichero a `.env` (ignorado por git). Placeholders de desarrollo, no secretos.

# Fuente única de verdad de la conexión (la usan docker-compose y Flyway).
POSTGRES_DB=datopublico
POSTGRES_USER=datopublico
# Obligatorio (fail-fast si falta).
POSTGRES_PASSWORD=cambia_esta_clave_local
# Opcional (default 5432).
POSTGRES_PORT=5432

# Overrides opcionales de Flyway (normalmente no hacen falta).
#FLYWAY_URL=jdbc:postgresql://localhost:5432/datopublico
#FLYWAY_HOST=localhost
#FLYWAY_PORT=5432
#FLYWAY_DB=datopublico
#FLYWAY_USER=datopublico
#FLYWAY_PASSWORD=cambia_esta_clave_local
