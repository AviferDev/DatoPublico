# Plantilla de variables de entorno para desarrollo local (FT00003).
#
# Copia este fichero a `.env` (ignorado por git) y ajústalo si lo necesitas.
# Los valores de aquí son **placeholders de desarrollo**, NO secretos reales ni
# credenciales válidas de nada: cámbialos en tu `.env` local. Los secretos de
# producción se inyectan por entorno en el servidor (FT00041) y **nunca** se
# versionan (ni los de desarrollo).

# --- Base de datos local (docker-compose) -------------------------------
# Única fuente de verdad de la conexión. `docker compose` la usa para levantar
# PostgreSQL y Flyway **deriva** de ella su URL (`jdbc:postgresql://host:port/db`):
# cambiar `POSTGRES_PORT` (o host/db/usuario) aquí basta para que ambos coincidan.
POSTGRES_DB=datopublico
POSTGRES_USER=datopublico
# Obligatorio: no hay default en docker-compose (`:?`) ni en Flyway (fail-fast).
# Placeholder de desarrollo, cámbialo en tu `.env`.
POSTGRES_PASSWORD=cambia_esta_clave_local
# Opcional: si se omite, se usa 5432.
POSTGRES_PORT=5432

# --- Overrides opcionales de Flyway -------------------------------------
# Normalmente NO hacen falta: si se omiten, Flyway usa las `POSTGRES_*` de arriba.
# Defínelas solo si necesitas apuntar Flyway a otra conexión (p. ej. una BD
# remota). `FLYWAY_URL` sobrescribe la URL completa; `FLYWAY_HOST`/`FLYWAY_PORT`/
# `FLYWAY_DB`/`FLYWAY_USER`/`FLYWAY_PASSWORD` sustituyen solo su pieza.
# `FLYWAY_PASSWORD` no tiene default: si no defines ni él ni `POSTGRES_PASSWORD`,
# la tarea Flyway falla con un mensaje claro.
#FLYWAY_URL=jdbc:postgresql://localhost:5432/datopublico
#FLYWAY_HOST=localhost
#FLYWAY_PORT=5432
#FLYWAY_DB=datopublico
#FLYWAY_USER=datopublico
#FLYWAY_PASSWORD=cambia_esta_clave_local
