# Plantilla de variables de entorno para desarrollo local (FT00003).
#
# Copia este fichero a `.env` (ignorado por git) y ajústalo si lo necesitas.
# Son valores por defecto de desarrollo, NO secretos reales; los de producción
# se inyectan por entorno en el servidor (FT00041).

# Base de datos local levantada por docker-compose.
POSTGRES_DB=datopublico
POSTGRES_USER=datopublico
POSTGRES_PASSWORD=datopublico
POSTGRES_PORT=5432

# Conexión de Flyway (opcional). Si no se definen, el plugin de Gradle usa los
# mismos valores de desarrollo por defecto que los de arriba.
# FLYWAY_URL=jdbc:postgresql://localhost:5432/datopublico
# FLYWAY_USER=datopublico
# FLYWAY_PASSWORD=datopublico
