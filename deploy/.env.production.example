# Plantilla de entorno de PRODUCCIÓN (FT00041). **Solo placeholders**: cópiala a
# `deploy/.env.production` (ignorado por git) y rellena los valores reales en el
# servidor. Nunca versiones secretos reales en este fichero.
#
# Uso: `docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production up -d`

# --- Dominio público (obligatorio; certificado TLS en /etc/letsencrypt) ---
DOMAIN=datopublico.example

# --- Puertos publicados de Nginx (defaults 80/443) ---
# Descomenta y ajusta si el VPS ya usa 80/443 para otro servicio (ver
# deploy/README.md, «Alternativas para no ocupar el puerto 80»).
#HTTP_PORT=80
#HTTPS_PORT=443
# Puerto del backend en el modo de prueba directa (override, SIN Nginx/HTTPS).
#BACKEND_PORT=8080

# --- PostgreSQL (fuente única de la conexión; la usan Compose y Flyway) ---
POSTGRES_DB=datopublico
POSTGRES_USER=datopublico
# Obligatorio (fail-fast si falta).
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Puerto publicado SOLO en loopback (default 5432).
POSTGRES_PORT=5432

# --- OpenCode (la clave vive solo en el servidor; nunca se versiona) ---
OPENCODE_API_KEY=REPLACE_WITH_OPENCODE_API_KEY
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4.1-flash

# --- Embeddings locales E5 (rutas DENTRO del contenedor; modelo por volumen) ---
EMBEDDING_MODEL_PATH=/models/multilingual-e5-small/model.onnx
EMBEDDING_TOKENIZER_PATH=/models/multilingual-e5-small/tokenizer.json
# Directorio del host con el modelo (relativo a deploy/ o absoluto).
EMBEDDING_MODEL_HOST_DIR=../backend/models

# --- API: CORS y rate limiting (por IP en memoria, FT00030) ---
CORS_ALLOWED_ORIGINS=https://datopublico.example
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=6
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# --- Ingesta (scheduler interno por corrutina, ADR 0004; sin cron externo) ---
INGESTA_ENABLED=true
INGESTA_TIMEZONE=Europe/Madrid
INGESTA_PRIMARY_TIME=09:30
INGESTA_SECONDARY_TIME=18:00
INGESTA_GRACE_MINUTES=30

# --- Proxy y proceso ---
# Confía en las cabeceras `X-Forwarded-*` de Nginx (solo seguro porque el backend
# no publica puerto). Con `false` el rate limiting vería la IP del proxy.
TRUST_PROXY_HEADERS=true
APP_ENV=production
LOG_LEVEL=INFO
# Heap de la JVM (~1 GB para el N100).
JAVA_TOOL_OPTIONS=-Xmx1g
